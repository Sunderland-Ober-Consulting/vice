{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-base",
      "displayName": "MSVC, optimized with debug info",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "/O2 /Z7",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Z7",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/DEBUG"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-base",
      "displayName": "MSVC, unoptimized with debug info",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "/Od /Z7",
        "CMAKE_CXX_FLAGS_DEBUG": "/Od /Z7",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "/DEBUG"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug" }
  ]
}
